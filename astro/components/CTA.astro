---
interface Props {
  title?: string;
  description?: string;
  variant?: 'standard' | 'cinematic';
}

const {
  title = 'Let’s talk about your next working day.',
  description = 'Tell us what you run, how your team works, and where the day gets complicated. We’ll walk through how DriveOps could fit.',
  variant = 'standard',
} = Astro.props;

const isCinematic = variant === 'cinematic';
const centralImage = '/images/illustrations/Fleet Tracking Dashboard Cityscape.webp';
const features = [
  { key: 'tracking', position: 'top-left', tone: 'blue', icon: 'pin', title: 'Live Tracking', description: 'Real-time vehicle locations and trip progress.', tilt: '-3deg', start: '59.5%', end: '61%' },
  { key: 'drivers', position: 'top-right', tone: 'orange', icon: 'users', title: 'Driver Management', description: 'Manage drivers, duties and coordination.', tilt: '-2deg', start: '89%', end: '90.5%' },
  { key: 'trips', position: 'bottom-left', tone: 'green', icon: 'calendar', title: 'Trip Management', description: 'Plan, assign and manage trips with ease.', tilt: '2deg', start: '41%', end: '42.5%' },
  { key: 'operations', position: 'bottom-right', tone: 'purple', icon: 'wrench', title: 'Vehicle Operations', description: 'Maintenance, fuel and compliance.', tilt: '-2deg', start: '6.5%', end: '8%' },
];
---

{isCinematic ? (
  <section class="orbital-cta-section" aria-labelledby="orbital-cta-title" data-orbital-cta>
    <div class="orbital-shell">
      <header class="orbital-heading">
        <p class="orbital-eyebrow"><span aria-hidden="true"></span>READY TO SIMPLIFY YOUR FLEET?<span aria-hidden="true"></span></p>
        <h2 id="orbital-cta-title">Your Entire Fleet.<span>One Connected Platform.</span></h2>
        <p>Manage trips, drivers, vehicles and everyday operations from one connected platform.</p>
      </header>

      <div class="orbital-stage">
        <div class="ambient-glow" aria-hidden="true"></div>
        <svg class="orbit-path" viewBox="0 0 1400 540" preserveAspectRatio="none" aria-hidden="true">
          <defs><filter id="orbit-glow"><feGaussianBlur stdDeviation="3" result="blur" /><feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge></filter></defs>
          <ellipse class="orbit-glow" cx="700" cy="276" rx="510" ry="198" />
          <ellipse class="orbit-base" cx="700" cy="276" rx="510" ry="198" pathLength="1" />
          <g class="orbit-particles" filter="url(#orbit-glow)"><circle r="4"><animateMotion dur="13s" repeatCount="indefinite" path="M190 276a510 198 0 1 0 1020 0 510 198 0 1 0-1020 0" /></circle><circle r="3"><animateMotion dur="17s" begin="-8s" repeatCount="indefinite" path="M190 276a510 198 0 1 0 1020 0 510 198 0 1 0-1020 0" /></circle></g>
          <g class="connector connector--tracking"><path pathLength="1" d="M172 112C200 116 221 130 258 151" /><circle cx="258" cy="151" r="7" /></g>
          <g class="connector connector--drivers"><path pathLength="1" d="M1228 112c-28 4-49 18-86 39" /><circle cx="1142" cy="151" r="7" /></g>
          <g class="connector connector--trips"><path pathLength="1" d="M184 420c27-3 53-13 94-31" /><circle cx="278" cy="389" r="7" /></g>
          <g class="connector connector--operations"><path pathLength="1" d="M1216 420c-27-3-53-13-94-31" /><circle cx="1122" cy="389" r="7" /></g>
        </svg>

        <figure class="central-illustration">
          <img
            src={centralImage}
            width="1774"
            height="887"
            alt="DriveOps fleet tracking dashboard with vehicles in a connected waterfront cityscape."
            loading="lazy"
            decoding="async"
          />
        </figure>

        <ul class="orbit-features" aria-label="Connected DriveOps capabilities">
          {features.map((feature, index) => (
            <li class={`feature-callout feature-callout--${feature.key} feature-callout--${feature.position} feature-callout--${feature.tone}`} style={`--feature-index:${index};--tilt:${feature.tilt};--orbit-start:${feature.start};--orbit-end:${feature.end}`}>
              <span class="feature-icon" aria-hidden="true">
                {feature.icon === 'calendar' && <svg viewBox="0 0 24 24"><path d="M7 2v3m10-3v3M4 9h16M5 4h14a1 1 0 0 1 1 1v15H4V5a1 1 0 0 1 1-1Z" /><path d="M8 13h3v3H8z" /></svg>}
                {feature.icon === 'users' && <svg viewBox="0 0 24 24"><path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20m6.5-9a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm7-5a3 3 0 0 1 0 6m1.5 2.5a4 4 0 0 1 3 3.9V20" /></svg>}
                {feature.icon === 'car' && <svg viewBox="0 0 24 24"><path d="m5 11 1.7-4.3A2 2 0 0 1 8.6 5.5h6.8a2 2 0 0 1 1.9 1.2L19 11m-15 0h16v7H4v-7Zm2 7v2m12-2v2M7.5 14.5h.01m8.99 0h.01" /></svg>}
                {feature.icon === 'pin' && <svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>}
                {feature.icon === 'wrench' && <svg viewBox="0 0 24 24"><path d="M14.7 6.3a4 4 0 0 0-5-5L12 3.6 9.6 6 7.3 3.7a4 4 0 0 0 5 5L4 17l3 3 8.3-8.3a4 4 0 0 0 5-5L18 9l-2.4-2.4 2.3-2.3a4 4 0 0 0-3.2 2Z" /></svg>}
                {feature.icon === 'fuel' && <svg viewBox="0 0 24 24"><path d="M5 21V4a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v17M3 21h14M7 7h6v5H7zM15 7h2l3 3v7.5a1.5 1.5 0 0 1-3 0V14" /></svg>}
              </span>
              <span class="feature-copy"><strong>{feature.title}</strong><span>{feature.description}</span></span>
            </li>
          ))}
        </ul>
      </div>

      <div class="orbital-close">
        <p>One platform. Complete fleet control.</p>
        <div class="orbital-actions">
          <a class="button orbital-primary" href="/contact/">Book a Free Demo <span aria-hidden="true">→</span></a>
          <a class="button orbital-secondary" href="https://driveops.chatserve.in/signup">Get Started <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="cta-section">
    <div class="container cta-inner">
      <div><p class="eyebrow">Your fleet. Your way of working.</p><h2>{title}</h2></div>
      <div class="cta-close">
        <p>{description}</p>
        <a class="button button-primary" href="/contact/">Book a demo <span aria-hidden="true">↗</span></a>
        <span class="contact-hint">A conversation with the DriveOps team.</span>
      </div>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-orbital-cta]').forEach((section) => {
    section.classList.add('motion-ready');
    if (!('IntersectionObserver' in window)) {
      section.classList.add('is-visible');
      return;
    }
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting) return;
      section.classList.add('is-visible');
      observer.unobserve(section);
    }, { threshold: 0.12 });
    observer.observe(section);
  });
</script>

<style>
  .cta-section{padding:var(--section-space) 0;border-top:1px solid var(--line);background:var(--accent)}
  .cta-inner{display:grid;grid-template-columns:1.2fr 1fr;align-items:center;gap:5rem}
  .cta-section .eyebrow{color:var(--ink)}.cta-section h2{max-width:650px;margin:.8rem 0 0;font-size:clamp(3.2rem,5.5vw,5rem)}
  .cta-section p{max-width:430px;color:var(--body)}.contact-hint{display:block;margin-top:.8rem;color:var(--body);font-size:.75rem}.cta-section .button{margin-top:.7rem}

  .orbital-cta-section{
    --cta-blue:#2166f5;--cta-blue-dark:#134fc8;--cta-navy:#101d3a;--cta-muted:#536886;
    position:relative;overflow:hidden;border-block:1px solid #d9e9f8;
    background:radial-gradient(circle at 50% 51%,rgba(71,166,255,.3) 0,rgba(174,220,255,.2) 32%,transparent 61%),linear-gradient(180deg,#fafdff 0%,#eaf6ff 42%,#dceeff 100%);
  }
  .orbital-cta-section::before,.orbital-cta-section::after{position:absolute;width:460px;height:230px;border-radius:50%;content:'';pointer-events:none;filter:blur(2px);opacity:.58;background:radial-gradient(ellipse,#d9eeff 0 46%,transparent 70%)}
  .orbital-cta-section::before{top:12%;left:-220px}.orbital-cta-section::after{top:17%;right:-220px}
  .orbital-shell{position:relative;z-index:1;width:min(1400px,calc(100% - 64px));margin-inline:auto;padding:clamp(3rem,4vw,3.9rem) 0 2.7rem}
  .orbital-heading{text-align:center}.orbital-eyebrow{display:flex;align-items:center;justify-content:center;gap:14px;margin:0 0 1rem;color:var(--cta-blue);font-size:.7rem;font-weight:800;letter-spacing:.055em}
  .orbital-eyebrow span{width:44px;height:1px;background:#6ea1ff}.orbital-heading h2{margin:0;color:var(--cta-navy);font-family:var(--font-display);font-size:clamp(2.8rem,4.15vw,4.2rem);font-weight:750;line-height:1.02;letter-spacing:-.05em;text-transform:none}.orbital-heading h2 span{display:block;color:var(--cta-blue)}
  .orbital-heading>p:last-child{max-width:680px;margin:.85rem auto 0;color:var(--cta-muted);font-size:clamp(.95rem,1.2vw,1.1rem);line-height:1.55}
  .orbital-stage{position:relative;height:clamp(520px,39vw,560px);margin-top:.35rem}.ambient-glow{position:absolute;z-index:-1;top:2%;left:50%;width:86%;height:98%;border-radius:50%;transform:translateX(-50%);background:radial-gradient(ellipse,rgba(35,133,240,.28),rgba(112,194,255,.1) 52%,transparent 74%);filter:blur(12px);animation:ambient-breathe 6s ease-in-out infinite}
  .orbit-path{position:absolute;z-index:0;inset:0;width:100%;height:100%;overflow:visible;fill:none;stroke-linecap:round;pointer-events:none}.orbit-glow{stroke:#48a6ff;stroke-width:7;opacity:.12;filter:blur(3px)}.orbit-base{stroke:#4b9cf4;stroke-width:2.1;opacity:.76}.orbit-particles{fill:#fff;stroke:#1680fa;stroke-width:2}.connector{color:#4e9ef5;stroke:currentColor;stroke-width:1.8;transition:color 180ms ease,filter 180ms ease}.connector path{fill:none}.connector circle{fill:#267ff5;stroke:#e6f4ff;stroke-width:7;transform-box:fill-box;transform-origin:center;animation:node-pulse 3.4s ease-in-out infinite}.connector:nth-of-type(even) circle{animation-delay:1s}
  .central-illustration{position:absolute;z-index:1;top:52%;left:50%;width:min(84%,1180px);margin:0;transform:translate(-50%,-50%)}
  .central-illustration::before{position:absolute;z-index:-1;right:18%;bottom:1.5%;left:18%;height:15%;border:1px solid rgba(56,145,244,.3);border-radius:50%;content:'';background:radial-gradient(ellipse,rgba(100,184,255,.2),transparent 68%);box-shadow:0 0 26px rgba(46,133,238,.12);transform:perspective(250px) rotateX(68deg)}
  .central-illustration::after{position:absolute;right:18%;bottom:2%;left:18%;height:8%;border-radius:50%;content:'';background:rgba(30,91,154,.18);filter:blur(18px)}
  .central-illustration img{position:relative;z-index:1;display:block;width:100%;height:auto;max-height:560px;object-fit:contain;filter:saturate(1.08) contrast(1.02) drop-shadow(0 18px 24px rgba(20,70,123,.17))}
  .orbit-features{margin:0;padding:0;list-style:none}.feature-callout{position:absolute;z-index:3;display:grid;width:clamp(250px,20vw,292px);min-height:102px;grid-template-columns:66px 1fr;align-items:center;gap:14px;border:1px solid rgba(93,154,220,.3);border-radius:22px;padding:15px 18px;color:var(--cta-navy);background:rgba(255,255,255,.88);box-shadow:0 16px 36px rgba(28,77,127,.12),inset 0 1px #fff;backdrop-filter:blur(11px);rotate:var(--tilt);transition:border-color 180ms ease,box-shadow 180ms ease,background-color 180ms ease,scale 180ms ease}
  .feature-callout--top-left{top:5%;left:0}.feature-callout--top-right{top:4%;right:0}.feature-callout--bottom-left{left:0;bottom:7%}.feature-callout--bottom-right{right:0;bottom:5%}
  .feature-icon{display:grid;width:66px;height:66px;place-items:center;border-radius:50%;color:#1765f5;background:linear-gradient(145deg,#eef6ff,#d7eaff);box-shadow:0 9px 20px rgba(33,102,245,.18),inset 0 2px #fff;transition:transform 180ms ease,box-shadow 180ms ease}.feature-callout--orange .feature-icon{color:#ff7418;background:linear-gradient(145deg,#fff5ec,#ffe2ca);box-shadow:0 9px 20px rgba(255,116,24,.18),inset 0 2px #fff}.feature-callout--green .feature-icon{color:#00a96b;background:linear-gradient(145deg,#effff8,#cef6e5);box-shadow:0 9px 20px rgba(0,169,107,.16),inset 0 2px #fff}.feature-callout--purple .feature-icon{color:#8548ef;background:linear-gradient(145deg,#f6f0ff,#e7d8ff);box-shadow:0 9px 20px rgba(132,72,239,.17),inset 0 2px #fff}
  .feature-icon svg{width:32px;height:32px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.feature-copy{display:block;min-width:0}.feature-copy strong{display:block;font-family:var(--font-display);font-size:1rem;line-height:1.2}.feature-copy>span{display:block;margin-top:6px;color:var(--cta-muted);font-size:.78rem;line-height:1.35}
  .feature-callout:hover{animation-play-state:paused!important;border-color:rgba(36,112,226,.58);background:#fff;box-shadow:0 20px 42px rgba(24,82,153,.18),inset 0 1px #fff;scale:1.025}.feature-callout:hover .feature-icon{transform:scale(1.06);box-shadow:0 12px 24px rgba(33,102,245,.23),inset 0 2px #fff}
  .orbital-stage:has(.feature-callout--trips:hover) .connector--trips,.orbital-stage:has(.feature-callout--drivers:hover) .connector--drivers,.orbital-stage:has(.feature-callout--tracking:hover) .connector--tracking,.orbital-stage:has(.feature-callout--operations:hover) .connector--operations{color:#075fdf;filter:drop-shadow(0 0 5px rgba(28,108,231,.62))}
  .orbital-close{margin-top:-.1rem;text-align:center}.orbital-close>p{margin:0 0 1rem;color:var(--cta-navy);font-family:var(--font-display);font-size:1rem;font-weight:700}.orbital-actions{display:flex;justify-content:center;gap:.8rem;flex-wrap:wrap}.orbital-actions .button{min-width:170px;min-height:50px;border-radius:11px;padding:.78rem 1.25rem;font-size:.9rem;transition:transform 180ms ease,background-color 180ms ease,border-color 180ms ease,box-shadow 180ms ease}.orbital-primary{color:#fff;background:var(--cta-blue);box-shadow:0 10px 24px rgba(33,102,245,.18)}.orbital-primary:hover{background:var(--cta-blue-dark);transform:translateY(-2px)}.orbital-secondary{border-color:#82adf8;color:#154fb9;background:rgba(255,255,255,.9)}.orbital-secondary:hover{border-color:var(--cta-blue);background:#fff;transform:translateY(-2px)}
  .orbital-cta-section a:focus-visible{outline:3px solid #0d50ca;outline-offset:4px}
  .motion-ready:not(.is-visible) :is(.orbital-heading,.central-illustration,.feature-callout,.orbital-close){opacity:0;transform:translateY(12px)}.motion-ready:not(.is-visible) .central-illustration{transform:translate(-50%,calc(-50% + 12px))}.motion-ready:not(.is-visible) :is(.orbit-base,.connector path){stroke-dasharray:1;stroke-dashoffset:1}
  .is-visible .orbital-heading{animation:orbital-rise 520ms ease-out both}.is-visible .central-illustration{animation:central-reveal 720ms 80ms ease-out both}.is-visible :is(.orbit-base,.connector path){animation:orbit-draw 950ms 160ms ease-out both}.is-visible .feature-callout{animation:orbital-rise 500ms calc(190ms + var(--feature-index)*70ms) ease-out both}.is-visible .orbital-close{animation:orbital-rise 520ms 400ms ease-out both}
  @keyframes orbital-rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}@keyframes feature-reveal{from{opacity:0;scale:.97}to{opacity:1;scale:1}}@keyframes central-reveal{from{opacity:0;transform:translate(-50%,calc(-50% + 12px)) scale(.975)}to{opacity:1;transform:translate(-50%,-50%) scale(1)}}@keyframes orbit-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}@keyframes node-pulse{0%,100%{transform:scale(1);opacity:.85}50%{transform:scale(1.3);opacity:1}}@keyframes ambient-breathe{0%,100%{opacity:.78;scale:1}50%{opacity:1;scale:1.035}}@keyframes feature-orbit{from{offset-distance:var(--orbit-start)}to{offset-distance:var(--orbit-end)}}
  @supports (offset-path:ellipse(40% 30% at 50% 50%)){
    @media(min-width:801px){.feature-callout{top:0;right:auto;bottom:auto;left:0;offset-path:ellipse(46% 36% at 50% 52%);offset-anchor:center;offset-rotate:0deg;offset-distance:var(--orbit-start)}.is-visible .feature-callout{animation:feature-reveal 500ms 180ms ease-out both,feature-orbit 9s 1.1s ease-in-out infinite alternate}.is-visible .feature-callout:nth-child(2){animation-duration:500ms,10s;animation-delay:250ms,.4s}.is-visible .feature-callout:nth-child(3){animation-duration:500ms,11s;animation-delay:320ms,-.3s}.is-visible .feature-callout:nth-child(4){animation-duration:500ms,9.5s;animation-delay:390ms,-1s}}
  }
  @media(max-width:1100px){.orbital-shell{width:min(100% - 44px,1000px)}.orbital-stage{height:520px}.central-illustration{width:78%}.feature-callout{width:225px;min-height:88px;grid-template-columns:52px 1fr;padding:12px 13px}.feature-icon{width:52px;height:52px}.feature-icon svg{width:26px;height:26px}.feature-copy strong{font-size:.88rem}.feature-copy>span{font-size:.7rem}}
  @media(max-width:800px){.orbital-shell{width:min(100% - 40px,700px);padding:3.2rem 0}.orbital-heading h2{font-size:clamp(2.7rem,8vw,3.8rem)}.orbital-stage{display:flex;height:auto;margin-top:2rem;flex-direction:column}.ambient-glow{top:0;width:100%;height:360px;animation:none}.orbit-path{display:none}.central-illustration{position:relative;top:auto;left:auto;width:min(100%,560px);margin-inline:auto;transform:none}.central-illustration img{max-height:none}.orbit-features{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:1.2rem}.feature-callout{position:relative;inset:auto;width:auto;min-height:90px;rotate:0deg}.orbital-close{margin-top:1.8rem}.motion-ready:not(.is-visible) .central-illustration{transform:translateY(14px)}.is-visible .central-illustration{animation-name:orbital-rise}.is-visible .feature-callout{animation-name:orbital-rise;animation-duration:550ms;animation-iteration-count:1}}
  @media(max-width:520px){.orbital-shell{width:min(100% - 32px,480px);padding:2.7rem 0}.orbital-eyebrow{gap:8px;font-size:.6rem}.orbital-eyebrow span{width:22px}.orbital-heading h2{font-size:clamp(2.35rem,11vw,3rem)}.orbital-heading>p:last-child{margin-top:.8rem;font-size:.9rem}.orbital-stage{margin-top:1.5rem}.central-illustration img{border-radius:14px}.orbit-features{gap:9px}.feature-callout{min-height:96px;grid-template-columns:1fr;align-content:start;gap:8px;padding:12px}.feature-icon{width:38px;height:38px;border-radius:11px}.feature-copy strong{font-size:.78rem}.feature-copy>span{font-size:.67rem}.orbital-actions{gap:.6rem}.orbital-actions .button{min-width:0;min-height:46px;flex:1 1 0;padding:.68rem .55rem;font-size:.76rem}.orbital-close>p{font-size:.9rem}}
  @media(max-width:750px){.cta-inner{grid-template-columns:1fr;gap:1.5rem}}
  @media(prefers-reduced-motion:reduce){.motion-ready:not(.is-visible) :is(.orbital-heading,.central-illustration,.feature-callout,.orbital-close){opacity:1;transform:none}.motion-ready:not(.is-visible) .central-illustration{transform:none}.motion-ready:not(.is-visible) .orbit-base{stroke-dasharray:none;stroke-dashoffset:0}.motion-ready:not(.is-visible) .connector path{stroke-dasharray:none;stroke-dashoffset:0}.is-visible :is(.orbital-heading,.central-illustration,.feature-callout,.orbital-close,.orbit-base,.connector path,.connector circle,.ambient-glow){animation:none}.orbit-particles{display:none}.feature-callout,.feature-icon,.connector,.orbital-actions .button{transition:none}.feature-callout:hover .feature-icon,.orbital-actions .button:hover{transform:none}.feature-callout:hover{scale:1}}
</style>
