---
const trips = [
 {time:'09:30',trip:'Airport transfer',route:'Kochi airport → Fort Kochi',driver:'Demo driver',status:'Accepted',selected:true},
 {time:'10:15',trip:'City pickup',route:'Ernakulam → Kakkanad',driver:'Demo driver',status:'Assigned',selected:false},
 {time:'11:00',trip:'Hotel transfer',route:'Fort Kochi → Kochi airport',driver:'Not allocated',status:'To allocate',selected:false},
];
---
<figure class="dispatch-scene" aria-label="Illustrative dispatch workspace with an accepted airport transfer">
 <div class="scene-top"><div class="scene-brand"><span class="scene-symbol" aria-hidden="true">↗</span><b>DriveOps</b><span class="workspace-label">Operations workspace</span></div><span class="sample-label">Illustrative workspace · sample data</span></div>
 <div class="scene-grid"><div class="scene-sidebar" aria-hidden="true"><span class="sidebar-label">WORKSPACE</span><span class="sidebar-active">↗ &nbsp; Trips & dispatch</span><span>↳ &nbsp; Drivers</span><span>□ &nbsp; Vehicles</span><span>⌁ &nbsp; Live fleet</span><span class="sidebar-bottom">THE WORK BEHIND<br/>EVERY TRIP.</span></div>
 <div class="scene-main"><div class="scene-title"><div><span class="scene-eyebrow">THE DAY’S WORK</span><h2>Trips & dispatch</h2></div><span class="today-label">Today’s assignments</span></div><div class="trip-table"><div class="table-head" aria-hidden="true"><span>Pickup</span><span>Trip details</span><span>Driver</span><span>Response</span></div>{trips.map(trip => <div class:list={['scene-trip',{'chosen-trip':trip.selected}]}><span class="pickup-time"><small>Pickup</small>{trip.time}</span><div class="trip-name"><b>{trip.trip}</b><span>{trip.route}</span></div><span class="trip-driver"><small>Driver</small>{trip.driver}</span><span class:list={['response',{'accepted':trip.selected}]}>{trip.selected && <span aria-hidden="true">✓ </span>}{trip.status}</span></div>)}</div><div class="scene-note"><span aria-hidden="true">↳</span><span>Your team chooses the assignment. The driver confirms the response.</span></div></div>
 <aside class="response-panel" aria-label="Sample driver response"><span class="scene-eyebrow">BACK FROM THE ROAD</span><div class="response-icon" aria-hidden="true">✓</div><h3>Assignment<br/>accepted.</h3><p>The driver’s response is back with the dispatch team.</p><dl><div><dt>Trip</dt><dd>Airport transfer</dd></div><div><dt>Pickup</dt><dd>09:30 · Kochi airport</dd></div></dl><span class="response-foot">Office <span aria-hidden="true">↔</span> Driver</span></aside></div>
 <figcaption><span>From booking to a clear response.</span><span>Conceptual demonstration, not a live product screen.</span></figcaption>
</figure>
<style>
.dispatch-scene{margin:0;background:var(--surface);border:1px solid var(--ink);border-radius:10px;overflow:hidden;color:var(--ink)}.scene-top{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 1.3rem;border-bottom:1px solid var(--line)}.scene-brand{display:flex;align-items:center;gap:.65rem;font-size:.95rem}.scene-symbol{display:grid;place-items:center;width:25px;height:25px;background:var(--ink);color:var(--accent);font-size:1.1rem}.workspace-label{border-left:1px solid var(--line);padding-left:.8rem;font-size:.7rem;color:var(--muted)}.sample-label{font-size:.65rem;color:var(--muted)}.scene-grid{display:grid;grid-template-columns:155px minmax(0,1fr) 235px;min-height:335px}.scene-sidebar{background:var(--paper);border-right:1px solid var(--line);padding:1.4rem .8rem;display:flex;flex-direction:column;gap:.3rem;font-size:.7rem}.scene-sidebar>span{padding:.6rem .65rem}.scene-sidebar .sidebar-label{font-size:.55rem;letter-spacing:.1em;color:var(--muted);padding:.1rem .65rem .7rem}.sidebar-active{background:var(--accent);font-weight:600;border-radius:3px}.scene-sidebar .sidebar-bottom{margin-top:auto;font-size:.55rem;letter-spacing:.08em;color:var(--muted);line-height:1.6}.scene-main{padding:1.5rem;min-width:0}.scene-title{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:1.5rem}.scene-eyebrow{font-size:.6rem;letter-spacing:.1em;font-weight:600;color:var(--muted)}.scene-title h2{font:600 1.3rem/1.3 var(--font-body);letter-spacing:-.035em;text-transform:none;margin:.3rem 0 0}.today-label{font-size:.6rem;border:1px solid var(--line);padding:.4rem .6rem;color:var(--muted)}.table-head,.scene-trip{display:grid;grid-template-columns:48px minmax(0,1.7fr) minmax(65px,.8fr) 78px;align-items:center;gap:.6rem}.table-head{font-size:.6rem;color:var(--muted);padding:0 .65rem .6rem}.scene-trip{padding:.85rem .65rem;border-top:1px solid var(--line);font-size:.7rem;min-height:65px}.scene-trip.chosen-trip{background:#eff6e7;border-top-color:var(--brand)}.pickup-time{font-variant-numeric:tabular-nums;font-weight:600}.pickup-time small,.trip-driver small{display:none}.trip-name b{display:block;font-weight:600;font-size:.75rem;line-height:1.4}.trip-name>span{display:block;font-size:.6rem;color:var(--muted);margin-top:.25rem}.trip-driver{font-size:.65rem;color:var(--muted)}.response{font-size:.6rem;color:var(--muted);text-align:center;padding:.25rem}.response.accepted{background:var(--accent);color:var(--ink);border-radius:3px;font-weight:600}.scene-note{display:flex;align-items:start;gap:.5rem;margin-top:1.2rem;font-size:.65rem;color:var(--muted)}.scene-note>span:first-child{color:var(--brand);font-size:1rem;line-height:1.2}.response-panel{background:var(--tint);padding:1.5rem;border-left:1px solid var(--line)}.response-icon{display:grid;place-items:center;width:34px;height:34px;margin:1rem 0;background:var(--brand);color:white;border-radius:50%;font-size:1.1rem}.response-panel h3{font:600 1.55rem/1.1 var(--font-body);letter-spacing:-.045em;margin:.5rem 0 .75rem}.response-panel p{font-size:.75rem;line-height:1.5;margin:0;color:var(--body)}.response-panel dl{margin:1.3rem 0 1rem}.response-panel dl>div{border-top:1px solid var(--line);padding:.55rem 0;font-size:.65rem}.response-panel dt{color:var(--muted);font-size:.55rem}.response-panel dd{margin:.2rem 0 0;font-weight:600}.response-foot{font-size:.65rem;display:flex;justify-content:space-between;gap:1rem}figcaption{display:flex;justify-content:space-between;gap:1rem;padding:.75rem 1.3rem;border-top:1px solid var(--line);font-size:.65rem;color:var(--muted)}
@media(max-width:1050px){.scene-grid{grid-template-columns:125px minmax(0,1fr) 200px}.scene-sidebar{padding:1rem .4rem;font-size:.6rem}.scene-main{padding:1.25rem}.response-panel{padding:1.25rem}.table-head,.scene-trip{grid-template-columns:40px minmax(0,1.7fr) 70px}.trip-driver,.table-head>span:nth-child(3){display:none}.scene-title{gap:.5rem}.today-label{font-size:.55rem}.response-panel h3{font-size:1.4rem}}
@media(max-width:760px){.scene-grid{grid-template-columns:minmax(0,1fr) 190px;min-height:0}.scene-sidebar{display:none}.workspace-label{display:none}.scene-main{padding:1.25rem}.scene-top{padding:.8rem 1rem}.sample-label{font-size:.6rem;max-width:150px;text-align:right}.scene-title h2{font-size:1.2rem}.today-label{display:none}figcaption{padding:.7rem 1rem;font-size:.6rem}}
@media(max-width:560px){.scene-grid{grid-template-columns:1fr}.scene-main{padding:1.25rem 1rem}.scene-title{margin-bottom:1.2rem}.table-head{display:none}.scene-trip{grid-template-columns:48px minmax(0,1fr) 76px;gap:.5rem;padding:.8rem .5rem;min-height:75px}.trip-name b{font-size:.85rem}.trip-name>span{font-size:.7rem;line-height:1.5}.pickup-time{font-size:.85rem}.pickup-time small{display:block;font-size:.6rem;font-weight:400;color:var(--muted)}.response{font-size:.65rem}.scene-note{font-size:.75rem;margin:1.1rem .25rem 0}.response-panel{border-left:0;border-top:1px solid var(--line);padding:1.3rem 1.5rem;display:grid;grid-template-columns:38px 1fr;gap:.4rem 1rem;align-items:center}.response-panel>.scene-eyebrow{grid-column:1/-1}.response-icon{grid-row:2/4;margin:.5rem 0}.response-panel h3{font-size:1.35rem;margin:.5rem 0 0}.response-panel h3 br{display:none}.response-panel p{font-size:.8rem;grid-column:2;margin:0}.response-panel dl{grid-column:1/-1;display:grid;grid-template-columns:1fr 1.2fr;gap:1rem;margin:.75rem 0 0}.response-panel dl>div{font-size:.75rem}.response-panel dt{font-size:.65rem}.response-foot{display:none}figcaption{display:block;font-size:.65rem;line-height:1.5}figcaption>span{display:block}figcaption>span+span{margin-top:.25rem}}
</style>
