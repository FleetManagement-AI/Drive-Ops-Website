---
interface Props {
  items: { q: string; a: string }[];
  title?: string;
  variant?: 'standard' | 'showcase';
}

const {
  items,
  title = 'A few useful answers.',
  variant = 'standard',
} = Astro.props;

const isShowcase = variant === 'showcase';
const accordionName = isShowcase ? 'homepage-driveops-faq' : 'driveops-faq';
---

<section class:list={['faq-section', { 'faq-showcase': isShowcase, 'faq-standard': !isShowcase }]} aria-labelledby={isShowcase ? 'homepage-faq-title' : 'faq-title'}>
  <div class:list={['container', 'faq-grid']}>
    <header class="faq-intro">
      {isShowcase ? (
        <>
          <p class="faq-badge">NEED SOME CLARITY?</p>
          <h2 id="homepage-faq-title">Frequently Asked <span>Questions</span></h2>
          <p class="faq-description">Everything you need to know about managing your fleet with DriveOps. Can't find your answer? Our team is happy to help.</p>
        </>
      ) : (
        <>
          <p class="eyebrow">Good to know</p>
          <h2 id="faq-title">{title}</h2>
          <a class="text-link" href="/contact/">Ask our team ↗</a>
        </>
      )}
    </header>

    {isShowcase && (
      <figure class="faq-illustration">
        <div class="faq-glow" aria-hidden="true"></div>
        <img
          src="/images/illustrations/Thinking About Transport Options.webp"
          width="1536"
          height="1024"
          alt="A fleet operator considering a question beside a taxi, passenger van and coach bus in a Kerala-inspired city."
          loading="lazy"
          decoding="async"
        />
      </figure>
    )}

    <div class="faq-list" data-faq-accordion>
      {items.map((item, index) => (
        <details name={accordionName} open={isShowcase && index === 0}>
          <summary>
            {isShowcase && <span class="faq-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>}
            <span class="faq-question">{item.q}</span>
            <span class="faq-icon" aria-hidden="true"><span></span><span></span></span>
          </summary>
          <div class="faq-answer-shell">
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq-accordion]').forEach((accordion) => {
    const items = Array.from(accordion.querySelectorAll<HTMLDetailsElement>('details'));

    items.forEach((item) => {
      item.addEventListener('toggle', () => {
        if (!item.open) return;
        items.forEach((otherItem) => {
          if (otherItem !== item) otherItem.open = false;
        });
      });
    });
  });
</script>

<style>
  .faq-section {
    --faq-blue: #1769ff;
    --faq-navy: #101d3a;
    --faq-muted: #536582;
  }

  .faq-grid { display: grid; }
  .faq-intro h2 { margin: 0; }
  .faq-list { min-width: 0; }
  .faq-list details { overflow: clip; }
  .faq-list summary {
    display: flex;
    align-items: center;
    width: 100%;
    list-style: none;
    cursor: pointer;
  }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-question { min-width: 0; }
  .faq-icon {
    position: relative;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
  }
  .faq-icon span {
    position: absolute;
    width: 14px;
    height: 2px;
    border-radius: 999px;
    background: currentColor;
    transition: transform 220ms ease;
  }
  .faq-icon span:last-child { transform: rotate(90deg); }
  details[open] .faq-icon span:last-child { transform: rotate(0deg); }
  .faq-answer-shell {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 280ms ease;
  }
  details[open] .faq-answer-shell { grid-template-rows: 1fr; }
  .faq-answer { min-height: 0; overflow: hidden; }
  .faq-answer p { margin-top: 0; }
  .faq-list summary:focus-visible {
    outline: 3px solid #0d50ca;
    outline-offset: -3px;
  }

  .faq-standard {
    padding: var(--section-space) 0;
    background: var(--surface);
  }
  .faq-standard .faq-grid { grid-template-columns: .8fr 1.2fr; gap: 5rem; }
  .faq-standard .faq-intro h2 { margin: .7rem 0 1rem; }
  .faq-standard .faq-list details { border-top: 1px solid var(--line); }
  .faq-standard .faq-list details:last-child { border-bottom: 1px solid var(--line); }
  .faq-standard summary {
    min-height: 64px;
    padding: 1.2rem 0;
    gap: 1.5rem;
    font-size: .95rem;
    font-weight: 600;
  }
  .faq-standard summary:hover { color: var(--brand); }
  .faq-standard .faq-icon { width: 24px; height: 24px; margin-left: auto; color: var(--brand); }
  .faq-standard .faq-answer p { margin-bottom: 1.3rem; color: var(--muted); font-size: .93rem; }

  .faq-showcase {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4.5rem, 6vw, 6rem) 0;
    color: var(--faq-navy);
    background:
      radial-gradient(circle at 82% 47%, #cfe9ff75 0%, transparent 30%),
      linear-gradient(120deg, #fff 0%, #f8fcff 55%, #eef8ff 100%);
  }
  .faq-showcase::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    pointer-events: none;
    background:
      radial-gradient(ellipse 30rem 18rem at 92% 18%, #dcefff85 0%, transparent 72%),
      radial-gradient(ellipse 22rem 14rem at 72% 85%, #e8f5ff 0%, transparent 74%);
  }
  .faq-showcase .faq-grid {
    width: min(1440px, calc(100% - 80px));
    margin-inline: auto;
    grid-template-columns: minmax(420px, .95fr) minmax(0, 1.05fr);
    grid-template-areas:
      'intro list'
      'art list';
    align-items: start;
    column-gap: clamp(2.5rem, 5vw, 5rem);
    row-gap: 2rem;
  }
  .faq-showcase .faq-intro { grid-area: intro; max-width: 760px; }
  .faq-badge {
    display: inline-flex;
    margin: 0 0 .9rem;
    padding: .46rem .9rem;
    border-radius: 999px;
    color: var(--faq-blue);
    background: #e5f1ff;
    font-size: .72rem;
    font-weight: 750;
    letter-spacing: .03em;
    line-height: 1.2;
  }
  .faq-showcase .faq-intro h2 {
    color: var(--faq-navy);
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 4vw, 3.9rem);
    font-weight: 750;
    line-height: 1.04;
    letter-spacing: -.045em;
    text-transform: none;
  }
  .faq-showcase .faq-intro h2 span { color: var(--faq-blue); }
  .faq-description {
    max-width: 650px;
    margin: 1rem 0 0;
    color: var(--faq-muted);
    font-size: clamp(.98rem, 1.15vw, 1.08rem);
    line-height: 1.55;
  }
  .faq-illustration {
    position: relative;
    grid-area: art;
    align-self: start;
    display: grid;
    min-width: 0;
    margin: 0;
    place-items: center;
  }
  .faq-glow {
    position: absolute;
    z-index: -1;
    width: 92%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #baddff80 0%, #dcefff42 46%, transparent 72%);
    filter: blur(12px);
  }
  .faq-illustration img {
    display: block;
    width: min(112%, 720px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 18px 22px #174b7d16);
  }
  .faq-showcase .faq-list {
    grid-area: list;
    display: grid;
    gap: .7rem;
  }
  .faq-showcase .faq-list details {
    border: 1px solid #dce8f5;
    border-radius: 15px;
    background: #ffffffdb;
    box-shadow: 0 7px 18px #173f6707;
    transition: border-color 220ms ease, background-color 220ms ease, box-shadow 220ms ease;
  }
  .faq-showcase .faq-list details[open] {
    border-color: #9bc6ff;
    background: #f7fbff;
    box-shadow: 0 10px 24px #1769ff0d;
  }
  .faq-showcase summary {
    min-height: 64px;
    padding: .75rem 1rem;
    gap: .85rem;
    color: var(--faq-navy);
    font-size: clamp(.94rem, 1.05vw, 1.04rem);
    font-weight: 700;
    line-height: 1.35;
  }
  .faq-showcase summary:hover { color: #0e54cb; }
  .faq-number {
    display: grid;
    flex: 0 0 auto;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    place-items: center;
    color: #46617e;
    background: #edf3fa;
    font-size: .75rem;
    font-weight: 750;
  }
  .faq-showcase details[open] .faq-number { color: #fff; background: var(--faq-blue); }
  .faq-showcase .faq-icon {
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    color: #46617e;
  }
  .faq-showcase details[open] .faq-icon { color: var(--faq-blue); }
  .faq-showcase .faq-answer p {
    margin: 0;
    padding: 0 3.9rem 1rem 4.15rem;
    color: var(--faq-muted);
    font-size: .94rem;
    line-height: 1.55;
  }

  @media (max-width: 1040px) {
    .faq-showcase .faq-grid {
      width: min(960px, calc(100% - 48px));
      grid-template-columns: minmax(340px, .9fr) minmax(0, 1.1fr);
      column-gap: 2rem;
    }
    .faq-showcase .faq-intro h2 { font-size: clamp(2.5rem, 4.8vw, 3.25rem); }
    .faq-illustration img { width: min(108%, 580px); }
    .faq-showcase summary { min-height: 60px; }
  }

  @media (max-width: 760px) {
    .faq-standard .faq-grid { grid-template-columns: 1fr; gap: 2rem; }
    .faq-showcase { padding: 3.5rem 0 4rem; }
    .faq-showcase .faq-grid {
      width: calc(100% - 36px);
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'intro'
        'art'
        'list';
      gap: 1.75rem;
    }
    .faq-showcase .faq-intro { text-align: center; }
    .faq-description { margin-inline: auto; }
    .faq-illustration img { width: min(100%, 560px); max-height: 350px; }
    .faq-showcase .faq-list { gap: .65rem; }
  }

  @media (max-width: 480px) {
    .faq-showcase { padding: 3rem 0 3.5rem; }
    .faq-showcase .faq-grid { width: calc(100% - 32px); gap: 1.5rem; }
    .faq-badge { margin-bottom: .75rem; font-size: .65rem; }
    .faq-showcase .faq-intro h2 { font-size: clamp(2.25rem, 10.4vw, 2.8rem); }
    .faq-description { margin-top: .8rem; font-size: .93rem; }
    .faq-illustration img { max-height: 270px; }
    .faq-showcase summary { min-height: 62px; padding: .7rem .8rem; gap: .65rem; font-size: .92rem; }
    .faq-number { width: 2.05rem; height: 2.05rem; font-size: .7rem; }
    .faq-showcase .faq-icon { width: 1.7rem; height: 1.7rem; }
    .faq-showcase .faq-answer p { padding: 0 1rem .95rem 3.5rem; font-size: .88rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon span,
    .faq-answer-shell,
    .faq-showcase .faq-list details { transition: none; }
  }
</style>
