<script>
  const workflowSection = document.querySelector('.how-it-works');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (workflowSection && !reducedMotion && 'IntersectionObserver' in window) {
    workflowSection.classList.add('workflow-observe');
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        workflowSection.classList.add('workflow-visible');
        observer.disconnect();
      }
    }, { threshold: 0.12 });
    observer.observe(workflowSection);
  } else {
    workflowSection?.classList.add('workflow-visible');
  }
</script>
