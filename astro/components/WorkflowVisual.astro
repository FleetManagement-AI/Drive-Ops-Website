---
interface Props { kind?: string; title?: string; compact?: boolean; }
const { kind = 'trips-dispatch', title, compact = false } = Astro.props;
const variants: Record<string, { label: string; heading: string; rows: [string,string,string][]; note: string }> = {
 'trips-dispatch': {label:'Trips & dispatch',heading:'The next trip, in focus.',rows:[['09:30','Airport transfer','Assigned'],['10:15','City pickup','Accepted'],['11:00','Hotel transfer','To allocate']],note:'Check availability. Choose the assignment.'},
 'live-fleet': {label:'Available location updates',heading:'A clearer operating picture.',rows:[['Driver App','On-duty location','Received'],['Operations','Vehicle location','Available'],['Customer','Trip tracking link','Shared']],note:'Phone GPS updates depend on driver duty and connectivity.'},
 'driver-app': {label:'Driver App',heading:'The details travel with the driver.',rows:[['Trip','Airport transfer','Assigned'],['Response','Driver acknowledgement','Accepted'],['After trip','Trip sheet','To submit']],note:'Assignments, trip details and updates in one place.'},
 rentals: {label:'Self-drive rentals',heading:'From reservation to return.',rows:[['Booking','Vehicle reservation','Confirmed'],['Handover','Vehicle condition','Recorded'],['Return','Inspection & payment','To record']],note:'Illustrative lifecycle. Payment records are manual.'},
 compliance: {label:'Document readiness',heading:'Keep the next expiry in view.',rows:[['Insurance','Vehicle document','On file'],['Permit','Expiry date','Recorded'],['Reminder','Configured notification','Scheduled']],note:'Document organisation and configured expiry reminders.'},
 fuel: {label:'Fuel records',heading:'Keep each fill-up on record.',rows:[['Vehicle','Demo vehicle','Selected'],['Entry','Quantity & odometer','Recorded'],['History','Fuel log','Available']],note:'An organised record for your team to review.'},
 maintenance: {label:'Maintenance records',heading:'Give the next service some context.',rows:[['Vehicle','Service history','On file'],['Issue','Driver report','To review'],['Follow-up','Maintenance record','Updated']],note:'Records and reminders support staff follow-up.'},
 reviews: {label:'Customer feedback',heading:'Close the loop after the journey.',rows:[['Request','Configured WhatsApp flow','Sent'],['Response','Customer feedback','Received'],['Office','Review inbox','To review']],note:'Workflow illustration, not a customer testimonial.'},
 vehicles: {label:'Vehicle records',heading:'Ready for the next assignment.',rows:[['Fleet','Vehicle registry','Organised'],['Status','Vehicle availability','To check'],['Documents','Readiness records','On file']],note:'Vehicle records provide context for dispatch.'},
 drivers: {label:'Driver coordination',heading:'Know who is taking the trip.',rows:[['Driver','Profile & duty','Available'],['Assignment','Upcoming trip','Allocated'],['Response','Driver acknowledgement','Accepted']],note:'Keep the office and driver working from the same details.'},
};
const item = variants[kind] ?? {label:title ?? 'Connected operations',heading:'Keep the context with the work.',rows:[['Office','Trip details','Organised'],['Driver','Assignment','Received'],['Team','Next action','In view']] as [string,string,string][],note:'A connected workflow for your team.'};
---
<figure class:list={['workflow-visual', { compact }]} aria-label={`${item.label} workflow illustration`}>
 <div class="visual-top"><span class="visual-mark" aria-hidden="true">↗</span><span>{item.label}</span><small>Sample data</small></div>
 <div class="visual-content"><h3>{item.heading}</h3><div class="record-list">{item.rows.map(([label,value,status],i) => <div class="record"><span class="record-key">{label}</span><b>{value}</b><span class:list={['record-status',{'selected':i===1}]}>{status}</span></div>)}</div><p class="visual-note"><span aria-hidden="true">↳</span>{item.note}</p></div>
 <figcaption>Workflow illustration · not a live product screen</figcaption>
</figure>
<style>
.workflow-visual{margin:0;background:var(--surface);color:var(--ink);border:1px solid var(--line);min-width:0}.visual-top{display:flex;align-items:center;gap:.65rem;padding:1rem 1.25rem;border-bottom:1px solid var(--line);font-size:.75rem;font-weight:600}.visual-mark{display:grid;place-items:center;width:26px;height:26px;background:var(--brand);color:white;font-size:1rem}.visual-top small{margin-left:auto;font-weight:400;color:var(--muted);font-size:.65rem}.visual-content{padding:1.75rem}.visual-content h3{font-size:clamp(1.3rem,2vw,1.75rem);max-width:350px;margin:0 0 2rem}.record{display:grid;grid-template-columns:.7fr 1.4fr auto;align-items:center;gap:.75rem;padding:1rem 0;border-top:1px solid var(--line);font-size:.75rem}.record-key{color:var(--muted);font-variant-numeric:tabular-nums}.record b{font-weight:600}.record-status{font-size:.65rem;color:var(--muted);padding:.25rem .4rem}.record-status.selected{background:var(--accent);color:var(--ink)}.visual-note{display:flex;gap:.6rem;font-size:.75rem;line-height:1.5;color:var(--muted);margin:1.5rem 0 0}.visual-note>span{color:var(--brand);font-size:1rem}figcaption{padding:.7rem 1.25rem;border-top:1px solid var(--line);color:var(--muted);font-size:.65rem}.compact .visual-content{padding:1.25rem}.compact .visual-content h3{font-size:1.3rem;margin-bottom:1rem}.compact .record{font-size:.7rem;gap:.4rem}.compact .record-status{font-size:.6rem}.compact .visual-note{font-size:.7rem}.compact .visual-top{padding:.8rem 1rem}@media(max-width:520px){.visual-content{padding:1.25rem}.record{grid-template-columns:.65fr 1.4fr auto;gap:.5rem;font-size:.75rem}.visual-top{padding:.85rem 1rem;font-size:.7rem}.visual-top small{font-size:.6rem}.record-status{font-size:.6rem}}
</style>
