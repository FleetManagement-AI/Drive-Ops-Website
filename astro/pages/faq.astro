---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { priorityHomepageFaqs } from '../../src/data/homepage-faqs';
---
<Base title="Frequently Asked Questions | DriveOps" description="Answers about DriveOps fleet operations, driver workflows, tracking, WhatsApp and fleet care." faqs={priorityHomepageFaqs}><main id="main-content"><PageHero eyebrow="Frequently asked questions" title="A clearer picture before you start." description="Understand the workflows DriveOps supports and how they fit together. For questions specific to your fleet, talk to our team." /><FAQ items={priorityHomepageFaqs} title="What would you like to know?" /><CTA /></main></Base>
