---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
---
<Base title="Fleet Management Software India — Trips & Operations | DriveOps" description="Fleet operations software for trips, dispatch, Driver App, live tracking, rentals, fuel, maintenance, and compliance in India."><main id="main-content"><PageHero eyebrow="Fleet management software in India" title="Your fleet. One platform." description="Manage trips, drivers, vehicles, rentals, fuel, maintenance, and compliance from one organised workspace. Built for the daily work of Indian fleet teams." image="/images/driveops/hero.webp" imageAlt="Indian fleet operator beside a taxi, van and minibus with an illustrative fleet dashboard"/><section class="india-story"><div class="container"><p class="eyebrow">From the office to the road</p><h2>Built for the work behind every trip.</h2><div class="india-columns"><p>Coordinate bookings, check driver and vehicle availability, and make informed assignments. Keep the office and drivers connected through trip details and configured notifications.</p><p>View available location updates from on-duty drivers uploading phone GPS. Keep vehicle documents, fuel records, and maintenance history together for the next journey.</p></div><a class="text-link" href="/product/">Explore the platform →</a></div></section><CTA /></main></Base>
<style>
.india-story {
  padding: var(--section-space) 0;
}
.india-story h2 {
  max-width: 700px;
  margin: 1rem 0 2rem;
}
.india-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  color: var(--muted);
}
@media (max-width: 700px) {
  .india-columns {
    grid-template-columns: 1fr;
    gap: 0;
  }
}
</style>
