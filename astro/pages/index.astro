---
import Base from '../layouts/Base.astro';
import DispatchScene from '../components/DispatchScene.astro';
import DriverTask from '../components/DriverTask.astro';
import TripDemo from '../components/TripDemo.astro';
import WorkflowVisual from '../components/WorkflowVisual.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { priorityHomepageFaqs } from '../../src/data/homepage-faqs';
const journey = [
 ['Book & plan','Create the trip, pickup, stops and timing.'],
 ['Check & allocate','Review availability. Choose the driver and vehicle.'],
 ['Accept & execute','The driver responds, navigates and updates the trip.'],
 ['Complete & record','Keep trip sheets and follow-up with the journey.'],
];
const care = [
 {name:'Fuel logs',title:'Every fill-up, on record.',copy:'Keep quantities, odometer readings and receipts with the vehicle’s fuel history.',href:'fuel'},
 {name:'Maintenance',title:'Keep the next service in view.',copy:'Bring service records and driver-reported issues into the same operating picture.',href:'maintenance'},
 {name:'Compliance',title:'The right documents. Easier to find.',copy:'Organise vehicle documents and follow up on configured expiry reminders.',href:'compliance'},
];
const industries = [
 ['Taxi & cab fleets','Connect the next booking, driver and vehicle.','taxi-cab-fleets'],
 ['Travel & tour operators','Keep itineraries and the people delivering them together.','travel-tour-operators'],
 ['Corporate transport','Give recurring schedules a clear daily rhythm.','corporate-transport'],
 ['Self-drive rentals','Organise availability, handover and return records.','self-drive-rentals'],
];
---
<Base title="DriveOps | Fleet Management Software for Indian Fleet Teams" description="Connect trips, dispatch, drivers, customer updates and everyday fleet records with DriveOps. Fleet operations software for Indian taxi and travel operators." faqs={priorityHomepageFaqs}>
<main id="main-content">
 <section class="fleet-hero" aria-labelledby="hero-title"><div class="container"><div class="hero-intro"><div><p class="eyebrow">Fleet operations. People connected.</p><h1 id="hero-title">The work behind<br/>every trip.<br/><em>In one place.</em></h1></div><div class="hero-copy"><p>From the dispatch desk to the driver’s next stop. Keep trips, people and everyday fleet work moving together.</p><div class="hero-actions"><a class="button button-primary" href="/contact/">Book a demo <span aria-hidden="true">↗</span></a><a class="hero-secondary" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a></div><span class="hero-audience">Built for Indian taxi & travel operators.</span></div></div><div class="hero-product"><DispatchScene /></div><div class="hero-foot"><span>TRIPS <i aria-hidden="true">/</i> DRIVERS <i aria-hidden="true">/</i> FLEET CARE</span><p>One connected working day.</p><a href="/product/">Explore the platform <span aria-hidden="true">↗</span></a></div></div></section>
 <section class="journey-section" id="how-it-works"><div class="container"><div class="section-intro"><div><p class="eyebrow">From booking to completion</p><h2>A clear next step.<br/>All the way through.</h2></div><p>Keep the context with the trip. Your team makes the decisions; DriveOps brings the details and responses together.</p></div><ol class="journey-steps">{journey.map(([title,copy],i) => <li><span class="journey-number">0{i+1}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol></div></section>
 <section class="driver-section"><div class="container driver-grid"><div class="driver-copy"><p class="eyebrow">The office. The road. One shared picture.</p><h2>Good coordination<br/>goes both ways.</h2><p>Give drivers the assignment details they need. Bring their response and trip updates back to the team.</p><ul class="driver-capabilities"><li>Go on duty and receive assignments</li><li>Accept or reject, navigate, start and complete trips</li><li>Submit trip sheets, log fuel and report vehicle issues</li><li>Receive notifications in English, Hindi or Malayalam</li></ul><a class="button button-lime" href="/product/driver-app/">Meet the Driver App <span aria-hidden="true">↗</span></a><p class="offline-note">Selected offline support covers trip start/end, location and fuel. Assignment responses and trip sheets require connectivity.</p></div><div class="driver-product"><span class="driver-annotation">The next trip.<br/>The right details.<svg viewBox="0 0 80 50" aria-hidden="true"><path d="M3 4Q70 0 66 40M55 30L66 42L76 28"/></svg></span><DriverTask /></div></div></section>
 <section class="dispatch-section"><div class="container product-split"><div class="product-copy"><p class="eyebrow">Trips & dispatch</p><h2>You choose<br/>the assignment.<br/><em>Everyone gets<br/>the context.</em></h2><p>Check availability, select the driver and vehicle, and see the driver’s response. Follow the trip from allocation to completion.</p><a class="text-link" href="/product/trips-dispatch/">Explore trips & dispatch ↗</a></div><div class="trip-demo-wrap"><TripDemo /></div></div></section>
 <section class="tracking-section"><div class="container product-split reverse"><div class="tracking-art"><WorkflowVisual kind="live-fleet" /><div class="tracking-caption"><span class="caption-mark" aria-hidden="true">↳</span><p>The office sees available location updates.<br/>Customers can follow a supported tracking link.</p></div></div><div class="product-copy"><p class="eyebrow">Live fleet visibility</p><h2>A clearer view.<br/><em>Fewer follow-up calls.</em></h2><p>View available vehicle locations in your operations workspace and share supported trip tracking links with customers.</p><div class="tracking-note"><span aria-hidden="true">↳</span><p>Location updates depend on drivers being <strong>on duty</strong>, uploading phone GPS and having connectivity. Visibility follows the data being received.</p></div><a class="text-link" href="/product/live-fleet/">Explore fleet visibility ↗</a></div></div></section>
 <section class="care-section"><div class="container"><div class="section-intro"><div><p class="eyebrow">Between one journey and the next</p><h2>Look after the fleet.<br/>Keep the day moving.</h2></div><p>Fuel entries. Service history. Vehicle documents. Keep the everyday records close to the work they support.</p></div><div class="care-index">{care.map(item => <a href={`/product/${item.href}/`}><span class="care-name">{item.name}</span><div><h3>{item.title}</h3><p>{item.copy}</p></div><span class="care-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
 <section class="rental-section"><div class="container rental-grid"><div><p class="eyebrow">Self-drive rental operations</p><h2>From reservation<br/>to return.<br/><em>Keep it together.</em></h2><p>Coordinate availability, bookings, handover and return inspections. Keep manual payment records alongside the rental.</p><a class="text-link" href="/product/rentals/">Explore rental operations ↗</a></div><WorkflowVisual kind="rentals" /></div></section>
 <section class="communication-section"><div class="container communication-grid"><div class="communication-heading"><p class="eyebrow">Keep the conversation connected</p><h2>Before the trip.<br/>After the journey.</h2></div><div class="communication-item"><span class="communication-icon" aria-hidden="true">↗</span><h3>The right update.</h3><p>Configured WhatsApp workflows support assignment messages and customer trip confirmations.</p><a class="text-link" href="/product/notifications/">Explore notifications ↗</a></div><div class="communication-item"><span class="communication-icon" aria-hidden="true">↳</span><h3>A useful response.</h3><p>Supported review requests bring customer feedback into an inbox your team can follow up on.</p><a class="text-link" href="/product/reviews/">Explore customer feedback ↗</a></div></div></section>
 <section class="industry-section"><div class="container"><div class="section-intro"><div><p class="eyebrow">Built around your operation</p><h2>Different journeys.<br/><em>The same need for clarity.</em></h2></div><p>Explore the workflows that fit the way your fleet works.</p></div><div class="industry-grid">{industries.map(([title,copy,slug]) => <a href={`/solutions/${slug}/`}><h3>{title}<span aria-hidden="true">↗</span></h3><p>{copy}</p></a>)}</div></div></section>
 <FAQ items={priorityHomepageFaqs}/><CTA title="Your next working day. A little more connected." />
</main>
</Base>
<style>
.fleet-hero{padding:clamp(2.5rem,4.5vw,4rem) 0 0;background:var(--paper)}.hero-intro{display:grid;grid-template-columns:1.65fr 1fr;gap:4rem;align-items:center;margin-bottom:2.6rem}.hero-intro .eyebrow{margin:0 0 1rem;font-size:.65rem}h1{font-size:clamp(4.5rem,8.8vw,7.5rem);line-height:.9;letter-spacing:-.015em;margin:0;max-width:850px;font-weight:700;text-wrap:initial}em{color:var(--brand);font-style:normal}.hero-copy{padding-top:1.5rem}.hero-copy>p{font-size:1.05rem;line-height:1.65;max-width:340px;color:var(--body);margin:0 0 1.5rem}.hero-actions{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap}.hero-secondary{font-size:.8rem;font-weight:600;padding:.65rem .3rem;border-bottom:1px solid var(--ink);display:inline-flex;gap:.5rem}.hero-secondary:hover{color:var(--brand)}.hero-audience{display:block;margin-top:1.2rem;font-size:.7rem;color:var(--muted)}.hero-product{position:relative}.hero-foot{display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:1.2rem 0;font-size:.7rem}.hero-foot>span{font-size:.6rem;letter-spacing:.09em;color:var(--muted)}.hero-foot i{font-style:normal;padding:0 .6rem;color:var(--brand)}.hero-foot p{margin:0;color:var(--muted)}.hero-foot a{font-weight:600;color:var(--ink)}.hero-foot a:hover{color:var(--brand)}.journey-section,.dispatch-section,.tracking-section,.care-section,.rental-section,.communication-section,.industry-section{padding:var(--section-space) 0}.section-intro{display:grid;grid-template-columns:1.4fr 1fr;gap:5rem;align-items:end;margin-bottom:2.8rem}.section-intro h2{margin:.7rem 0 0}.section-intro>p{max-width:390px;font-size:.95rem;margin:0;color:var(--body)}.journey-steps{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;margin:0}.journey-steps>li{border-top:1px solid var(--line);padding-top:1.25rem}.journey-number{font-size:.7rem;color:var(--brand);font-variant-numeric:tabular-nums}.journey-steps h3{font-size:1rem;letter-spacing:-.02em;margin:.8rem 0 .65rem}.journey-steps p{font-size:.85rem;color:var(--muted);max-width:230px;margin:0}.driver-section{background:var(--ink);color:var(--on-dark);padding:clamp(3.5rem,6vw,5.5rem) 0}.driver-grid{display:grid;grid-template-columns:1.4fr 1fr;align-items:center;gap:5rem}.driver-copy .eyebrow{color:var(--accent);font-size:.65rem}.driver-copy h2{font-size:clamp(3.8rem,6.7vw,6rem);color:white;margin:1rem 0 1.3rem;line-height:.94}.driver-copy>p:not(.eyebrow){font-size:1rem;max-width:480px}.driver-capabilities{padding:0;list-style:none;margin:1.5rem 0 1.8rem}.driver-capabilities li{position:relative;font-size:.85rem;padding:.45rem 0 .45rem 1.2rem}.driver-capabilities li:before{content:'↗';position:absolute;left:0;color:var(--accent)}.button-lime{background:var(--accent);color:var(--ink);border-color:var(--accent)}.button-lime:hover{background:#c9ed91;border-color:#c9ed91}.driver-copy .offline-note{font-size:.7rem;line-height:1.6;margin:1.2rem 0 0;max-width:460px;color:var(--on-dark)}.driver-product{display:flex;justify-content:center;position:relative;padding:1rem 0}.driver-annotation{position:absolute;top:-.5rem;left:-.8rem;transform:rotate(-5deg);font-size:.7rem;color:var(--accent);line-height:1.4}.driver-annotation svg{display:block;width:65px;height:45px;margin-top:.4rem;stroke:var(--accent);stroke-width:1.5;fill:none}.product-split{display:grid;grid-template-columns:.8fr 1.35fr;gap:4rem;align-items:center}.product-copy h2{font-size:clamp(3.2rem,4.6vw,4.5rem);margin:.8rem 0 1.4rem}.product-copy>p:not(.eyebrow){font-size:.95rem;max-width:410px;color:var(--body)}.product-copy .text-link{font-size:.85rem;margin-top:.5rem}.trip-demo-wrap{min-width:0}.tracking-section{padding-top:1rem}.product-split.reverse{grid-template-columns:1.2fr 1fr;gap:5rem}.tracking-art{min-width:0}.tracking-caption{display:flex;gap:.7rem;align-items:start;padding:1.2rem 0 0}.caption-mark{color:var(--brand)}.tracking-caption p{font-size:.75rem;margin:0;color:var(--muted);line-height:1.5}.tracking-note{display:flex;gap:.7rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:1rem 0;margin:1.5rem 0;max-width:430px}.tracking-note>span{color:var(--brand)}.tracking-note p{margin:0;font-size:.8rem;color:var(--body)}.care-section{background:var(--tint);border-block:1px solid var(--line)}.care-index>a{display:grid;grid-template-columns:.7fr 2fr auto;gap:2rem;align-items:start;border-top:1px solid var(--line);padding:1.8rem 0}.care-index>a:last-child{border-bottom:1px solid var(--line)}.care-name{font-size:.8rem;font-weight:600;color:var(--brand);padding-top:.2rem}.care-index h3{font-size:1.35rem;letter-spacing:-.035em;margin:0 0 .5rem}.care-index p{font-size:.9rem;max-width:560px;color:var(--muted);margin:0}.care-arrow{font-size:1.6rem;color:var(--brand);line-height:1.2}.care-index a:hover h3{text-decoration:underline;text-underline-offset:5px}.rental-grid{display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center}.rental-grid h2{margin:.8rem 0 1.3rem}.rental-grid>div>p:not(.eyebrow){max-width:420px;color:var(--body);font-size:.95rem}.communication-section{padding-top:0}.communication-grid{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:3rem;align-items:start;border-top:1px solid var(--line);padding-top:2.5rem}.communication-heading h2{font-size:clamp(2.7rem,3.5vw,3.3rem);margin:.8rem 0 0}.communication-icon{display:inline-block;background:var(--accent);color:var(--ink);padding:.1rem .65rem;font-size:1.35rem}.communication-item h3{font-size:1.2rem;margin:1rem 0 .7rem}.communication-item p{font-size:.85rem;color:var(--muted)}.communication-item a{font-size:.75rem}.industry-section{background:var(--paper);padding-top:1rem}.industry-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem}.industry-grid>a{border-top:1px solid var(--ink);padding-top:1.3rem}.industry-grid h3{display:flex;justify-content:space-between;gap:.8rem;font-size:1.05rem;line-height:1.3;margin:0 0 .8rem;letter-spacing:-.02em}.industry-grid h3>span{color:var(--brand)}.industry-grid p{font-size:.85rem;color:var(--muted);margin:0}.industry-grid a:hover h3{color:var(--brand)}
@media(max-width:1100px){.hero-intro{grid-template-columns:1.5fr 1fr;gap:2rem}h1{font-size:clamp(4.5rem,9vw,6.5rem)}.hero-copy>p{font-size:1rem}.hero-actions{gap:.5rem}.hero-secondary{font-size:.75rem}.driver-grid{gap:3rem}.driver-annotation{display:none}.product-split{gap:2.5rem}.product-split.reverse{gap:3rem}.section-intro{gap:3rem}.rental-grid{gap:3rem}.communication-grid{gap:2rem}.industry-grid{gap:1.3rem}}
@media(max-width:800px){.hero-intro{gap:1.5rem;grid-template-columns:1.3fr 1fr}h1{font-size:clamp(3.8rem,8.5vw,5rem)}.hero-copy{padding-top:0}.hero-copy>p{font-size:.9rem}.hero-intro .eyebrow{font-size:.55rem}.hero-actions{align-items:start;flex-direction:column;gap:.4rem}.hero-audience{font-size:.6rem}.hero-foot p{display:none}.section-intro{gap:2rem}.journey-steps{grid-template-columns:1fr 1fr;gap:2rem}.journey-steps p{max-width:300px}.driver-grid{grid-template-columns:1fr 1fr;gap:2rem}.driver-copy h2{font-size:3.9rem}.driver-copy>p:not(.eyebrow){font-size:.9rem}.driver-capabilities li{font-size:.8rem}.product-split,.product-split.reverse{grid-template-columns:1fr;gap:2rem}.product-copy{max-width:620px}.product-copy>p:not(.eyebrow){max-width:560px}.product-copy h2 br{display:none}.product-copy h2{max-width:600px}.tracking-art{order:2}.rental-grid{gap:2rem}.communication-grid{grid-template-columns:1fr 1fr}.communication-heading{grid-column:1/-1}.communication-heading h2 br{display:none}.industry-grid{grid-template-columns:1fr 1fr;gap:2rem}.tracking-section{padding-top:0}}
@media(max-width:600px){.fleet-hero{padding-top:2rem}.hero-intro{grid-template-columns:1fr;gap:1.4rem;margin-bottom:1.8rem}.hero-intro .eyebrow{font-size:.6rem;margin-bottom:1rem}h1{font-size:clamp(4.1rem,15.8vw,5.7rem);max-width:500px;line-height:.92}.hero-copy>p{font-size:1rem;max-width:440px;margin-bottom:1.1rem}.hero-actions{flex-direction:row;align-items:center;gap:.9rem}.hero-audience{font-size:.7rem;margin-top:1rem}.hero-foot{align-items:start;flex-direction:column;gap:.6rem;padding:1.1rem 0}.hero-foot>span{font-size:.6rem}.hero-foot a{font-size:.75rem}.section-intro{grid-template-columns:1fr;gap:1.2rem;margin-bottom:2rem}.section-intro>p{max-width:500px}.section-intro h2{font-size:3.1rem}.journey-steps{gap:1.6rem 1.3rem}.journey-steps h3{font-size:1rem}.journey-steps p{font-size:.85rem}.driver-grid{grid-template-columns:1fr;gap:2rem}.driver-copy h2{font-size:clamp(3.8rem,14vw,4.6rem)}.driver-copy>p:not(.eyebrow){font-size:1rem}.driver-capabilities li{font-size:.9rem}.driver-copy .offline-note{font-size:.75rem}.driver-product{padding:.5rem 0 0}.product-copy h2{font-size:3.4rem}.care-index>a{grid-template-columns:1fr auto;gap:.6rem 1rem;padding:1.5rem 0}.care-name{grid-column:1/-1}.care-index h3{font-size:1.2rem}.care-index p{font-size:.85rem}.care-arrow{grid-column:2;grid-row:2}.rental-grid{grid-template-columns:1fr;gap:2rem}.rental-grid h2{font-size:3.4rem}.communication-grid{grid-template-columns:1fr;gap:2rem}.communication-heading{grid-column:auto}.communication-item{border-top:1px solid var(--line);padding-top:1.5rem}.communication-item p{max-width:420px;font-size:.9rem}.communication-item a{font-size:.85rem}.industry-grid{gap:1.8rem 1.3rem}.industry-grid h3{font-size:1rem}.industry-grid p{font-size:.85rem}}
</style>
