---
import Base from '../layouts/Base.astro';
import HomepageHero from '../components/HomepageHero.astro';
import FleetDashboardShowcase from '../components/FleetDashboardShowcase.astro';
import FeatureOverview from '../components/FeatureOverview.astro';
import SpreadsheetComparison from '../components/SpreadsheetComparison.astro';
import HowDriveOpsWorks from '../components/HowDriveOpsWorks.astro';
import IndustrySolutions from '../components/IndustrySolutions.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { priorityHomepageFaqs } from '../../src/data/homepage-faqs';
---
<Base title="DriveOps | Fleet Management Software for Indian Fleet Teams" description="Connect trips, dispatch, drivers, customer updates and everyday fleet records with DriveOps. Fleet operations software for Indian taxi and travel operators." faqs={priorityHomepageFaqs}>
<main id="main-content">
 <HomepageHero />
 <FeatureOverview />
 <SpreadsheetComparison />
 <HowDriveOpsWorks />
 <IndustrySolutions />
 <FleetDashboardShowcase />
 <FAQ items={priorityHomepageFaqs} variant="showcase"/><CTA variant="cinematic" />
</main>
</Base>
